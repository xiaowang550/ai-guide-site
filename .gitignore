# 依赖与构建产物
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# 本地环境变量（含代理地址、反馈仓库配置）
.env
.env.local
.env*.local

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 临时与本地文件
*.log
npm-debug.log*
.lighthouse/
lh*.json
.tmp/
*.tmp
tmp-*.mjs
scripts/_*.mjs

# Lighthouse / 性能采样产物
.perf/

# 本地后台开发用的 SQLite 文件（绝不进仓库）
.data/

# 构建时从后台同步的内容覆盖（由 scripts/sync-content.mjs 生成，不进仓库）
data/generated/content-override.json
.cache/

# 本地后台开发服务器的日志
admin-dev.out
admin-dev.err

# 临时输出（验证过程用，不要进仓库）
*.out
