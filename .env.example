# 环境变量示例。复制为 .env.local 后按需修改。
#
# 本地预览用的 AI 代理（不配置也不影响站点运行，只是助手 AI 模式不可用）
# AI_PROXY_UPSTREAM=https://your-endpoint/v1/chat/completions
# AI_PROXY_KEY=

# ---------- 站点 ----------
# 站点地址（用于 sitemap / canonical / opengraph）
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------- 勘误反馈的 GitHub 仓库 ----------
# 格式 owner/repo。配置后「提交到 GitHub Issue」入口与反馈统计面板才会出现；
# 未配置时这两个入口自动隐藏，复制与邮件两个出口始终可用。
#
# 为什么不配 token：token 放在前端等于公开给所有访客。
# 本站只做「预填好的 Issue 链接」与「匿名读公开 Issues API」。
NEXT_PUBLIC_FEEDBACK_REPO=owner/repo

# 说明：一期为纯静态站，不需要任何数据库或大模型 API Key。
# 后续若接入 CMS 或模型 API，在此补充对应变量。